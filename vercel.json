{
  "version": 2,
  "rewrites": [
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/login",
      "destination": "/member.html"
    },
    {
      "source": "/signal/id/(.*)",
      "destination": "/signal/index.html"
    },
    {
      "source": "/signal/list/(.*)",
      "destination": "/signal/index.html"
    },
    {
      "source": "/signal/recap",
      "destination": "/signal/index.html"
    },
    {
      "source": "/panduan/kamar-signal.pdf",
      "destination": "https://moxcqojvtglssftskouj.supabase.co/storage/v1/object/public/kamar-content/signal/panduan/Panduan-Kamar-Signal.pdf"
    },
    {
      "source": "/panduan/kamar-signal-alert-telegram.pdf",
      "destination": "https://moxcqojvtglssftskouj.supabase.co/storage/v1/object/public/kamar-content/signal/panduan/Panduan%20Arti%20Alert%20Kamar%20Signal%20-%20TELEGRAM.pdf"
    },
    {
      "source": "/panduan/kamar-signal-tampilan-website.pdf",
      "destination": "https://moxcqojvtglssftskouj.supabase.co/storage/v1/object/public/kamar-content/signal/panduan/Panduan%20Arti%20Tampilan%20Kamar%20Signal%20-%20WEBSITE%20PWA.pdf"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
